# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 구글맵 JavaScript API 키
VITE_GOOGLE_MAPS_API_KEY=

# 짧은 링크(maps.app.goo.gl 등)를 펼쳐주는 Cloudflare Worker 주소.
# worker/ 를 배포하면 나오는 주소를 넣으세요. (예: https://travel-mate.<계정>.workers.dev)
# 비워두면 공용 프록시(allorigins)로 폴백합니다.
#
# ※ Cloudflare Pages 로 배포하는 경우엔 이 .env 대신
#    Pages 프로젝트 → Settings → Variables 에 같은 이름/값으로 넣습니다.
VITE_LINK_RESOLVER_URL=
